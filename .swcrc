{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "exclude": [
    "node_modules",
    "dist",
    "\\.spec\\.ts$",
    "\\.e2e-spec\\.ts$"
  ],
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": false,
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "baseUrl": "./",
    "paths": {
      "src/*": ["src/*"]
    }
  },
  "module": {
    "type": "commonjs",
    "strict": false,
    "lazy": false,
    "noInterop": false
  },
  "minify": false
}
