{
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"formatter": {
		"enabled": true
	},
	"files": {
		"includes": ["**", "!**/dist", "!**/node_modules", "!**/src/metadata.ts"]
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},

	"linter": {
		"enabled": true,
		"rules": {
			"complexity": {
				"noStaticOnlyClass": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"overrides": [
		{
			"includes": ["**/*.controller.ts"],
			"linter": {
				"rules": {
					"style": {
						"useImportType": "off"
					}
				}
			}
		}
	]
}
