{
  "name": "backend",
  "version": "0.0.1",
  "description": "Campaign management API built with NestJS and Prisma.",
  "author": "Paulo Cheloni",
  "main": "dist/main.js",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "compodoc": "compodoc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r @swc-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "4.22.3",
    "nestjs-prisma": "0.27.0",
    "prisma-paginate": "5.2.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@compodoc/compodoc": "1.2.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@suites/di.nestjs": "3.1.0",
    "@suites/doubles.jest": "3.1.0",
    "@suites/unit": "3.1.1",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.21",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "jest-ctrf-json-reporter": "0.2.0",
    "jest-junit": "16.0.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@compodoc/compodoc",
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  }
}
